# ==============================================================================
# RAG / Cheminformatics Pipeline - Environment Configuration
# ==============================================================================

# LLM Providers (Groq & Gemini)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash-lite

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Local Embeddings (BGE-M3 + PyTorch CUDA)
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_BATCH_SIZE=8
EMBED_DEVICE=cuda
EMBED_TRUST_REMOTE_CODE=false

# Graph RAG & Entity Merge Settings
MERGE_SIMILARITY_THRESHOLD=0.6
MERGE_MAX_LLM_CHECKS=50
PG_PATH_DEPTH=3
PG_VECTOR_TOP_K=8
PG_REL_MAP_LIMIT=40

# Telemetry
PHOENIX_ENABLED=0
