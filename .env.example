# ==============================================================================
# LLM: Local Ollama với Qwen3 8B
# ==============================================================================
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# LLM Providers (Groq & Gemini - Optional Fallbacks)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash-lite

# ==============================================================================
# Neo4j Cloud (Neo4j AuraDB)
# ==============================================================================
# ⚠️ Lưu ý: Neo4j Aura BẮT BUỘC dùng giao thức "neo4j+s://" (đã bật mã hóa TLS)
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ==============================================================================
# Local Embeddings (BGE-M3)
# ==============================================================================
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_BATCH_SIZE=8
EMBED_DEVICE=cpu
EMBED_TRUST_REMOTE_CODE=false

# Graph RAG Settings
MERGE_SIMILARITY_THRESHOLD=0.6
MERGE_MAX_LLM_CHECKS=50
PG_PATH_DEPTH=3
PG_VECTOR_TOP_K=8
PG_REL_MAP_LIMIT=40
PHOENIX_ENABLED=0
